<!DOCTYPE HTML>
<html>
  <head>
  <title><%= content_for(:title) || current_site_config.site_data["title"] || "Igreja Presbiteriana" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta charset="utf-8">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
  <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <%# <meta property="og:title" content=""/>
  <meta property="og:image" content=""/>
  <meta property="og:url" content=""/>
  <meta property="og:site_name" content=""/>
  <meta property="og:description" content=""/>
  <meta name="twitter:title" content="" />
  <meta name="twitter:image" content="" />
  <meta name="twitter:url" content="" />
  <meta name="twitter:card" content="" /> %>

  <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:400,600,700" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css?family=Libre+Baskerville:400,400i,700" rel="stylesheet"
  >
  
  <!-- Animate -->
  <%= stylesheet_link_tag "animate" %>
  <!-- Icomoon Icon Fonts-->
  <%= stylesheet_link_tag "icomoon" %>
  <!-- Bootstrap  -->
  <%= stylesheet_link_tag "bootstrap" %>
  <!-- Magnific Popup -->
  <%= stylesheet_link_tag "magnific-popup" %>
  <!-- Flexslider  -->
  <%= stylesheet_link_tag "flexslider" %>
  <!-- Owl Carousel  -->
  <%= stylesheet_link_tag "owl.carousel.min" %>
  <%= stylesheet_link_tag "owl.theme.default.min" %>
  <!-- Theme style  -->
  <%= stylesheet_link_tag "style" %>

  <!-- Modernizr JS -->
  <%= javascript_include_tag "modernizr-2.6.2.min" %>

  <%= javascript_importmap_tags %>
  </head>
  <body>
    
  <div class="marinas-loader"></div>
  
  <div id="page">
  <nav class="marinas-nav" role="navigation">
		<div class="container-wrap">
			<div class="top-menu">
				<div class="row">
					<div class="col-md-12 col-offset-0 text-center">
						<div id="marinas-logo"><a href="/"><%= current_site_config.site_data["title"] %></a></div>
					</div>
					<div class="col-md-12 col-md-offset-0 text-center menu-1">
						<ul>
							<li class="<%= 'active' if controller_name == 'site' && action_name == 'home' %>"><a href="<%= home_path %>">Home</a></li>
							<li class="<%= 'active' if controller_name == 'sermons' %>"><a href="<%= sermons_path %>">Sermões</a></li>
							<li class="has-dropdown <%= 'active' if controller_name == 'news' %>">
								<a href="<%= posts_path(category: :news) %>">Notícias</a>
								<ul class="dropdown">
									<li><a href="#">Ministério</a></li>
									<li><a href="#">Missões</a></li>
								</ul>
							</li>
							<li><a href=<%= posts_path(category: :events) %>>Eventos</a></li>
							<li class="<%= 'active' if controller_name == 'site' && action_name == 'about' %>"><a href="<%= about_path %>">Sobre</a></li>
							<li class="<%= 'active' if controller_name == 'contacts' %>"><a href="<%= new_path %>">Contato</a></li>
							<li><a href="#" class="donate">Ofertas</a></li>
						</ul>
					</div>
				</div>
				
			</div>
		</div>
	</nav>
  <div class="container-wrap">
    <%= yield %>
  </div>

  <div class="container-wrap">
    <footer id="marinas-footer" role="contentinfo">
      <div class="col-md-4 text-center">
        <% if current_site_config.site_data["address_link"].present? %>
          <h3><a href="<%= current_site_config.site_data["address_link"] %>" target="_blank" rel="noopener"><%= current_site_config.site_data["address"] %></a></h3>
        <% else %>
          <h3><%= current_site_config.site_data["address"] %></h3>
        <% end %>
        <% if current_site_config.site_data["contact_phone"].present? %>
          <p><i class="icon-phone"></i> <%= current_site_config.site_data["contact_phone"] %></p>
        <% end %>
        <% if current_site_config.site_data["contact_email"].present? %>
          <p><i class="icon-envelope"></i> <%= current_site_config.site_data["contact_email"] %></p>
        <% end %>
      </div>
      <div class="col-md-4 text-center">
        <h2><%= current_site_config.site_data["title"] %></h2>
        <% if current_site_config.site_data["worship_schedule"].present? %>
          <p><i class="icon-clock"></i> <%= current_site_config.site_data["worship_schedule"] %></p>
        <% end %>
      </div>
      <div class="col-md-4 text-center">
        <p>
          <ul class="marinas-social-icons">
            <% if current_site_config.site_data["instagram"].present? %>
              <li><a href="<%= current_site_config.site_data["instagram"] %>" target="_blank" rel="noopener"><i class="icon-instagram"></i></a></li>
            <% end %>
            <% if current_site_config.site_data["youtube"].present? %>
              <li><a href="<%= current_site_config.site_data["youtube"] %>" target="_blank" rel="noopener"><i class="icon-youtube"></i></a></li>
            <% end %>
            <% if current_site_config.site_data["facebook"].present? %>
              <li><a href="<%= current_site_config.site_data["facebook"] %>" target="_blank" rel="noopener"><i class="icon-facebook2"></i></a></li>
            <% end %>
          </ul>
        </p>
      </div>
      <div class="row copyright">
        <div class="col-md-12 text-center">
          <p>
            <small class="block">&copy; <%= Time.now.year %> Igreja Presbiteriana Marinas Praia Sul. Todos os Direitos Reservados .</small> 
            <small class="block">Design por <a href="http://freehtml5.co/" target="_blank">FreeHTML5.co (Todos os Direitos Reservados)</a> Desenvolvido por: <a href="http://beacons.ai/luangb" target="_blank">LuanGB</a></small>
          </p>
        </div>
      </div>
    </footer>
  </div><!-- END container-wrap -->
  </div>

  <div class="gototop js-top">
    <a href="#" class="js-gotop"><i class="icon-arrow-up2"></i></a>
  </div>
  
  <!-- jQuery -->
  <%= javascript_include_tag "jquery.min" %>
  <!-- jQuery Easing -->
  <%= javascript_include_tag "jquery.easing.1.3" %>
  <!-- Bootstrap -->
  <%= javascript_include_tag "bootstrap.min" %>
  <!-- Waypoints -->
  <%= javascript_include_tag "jquery.waypoints.min" %>
  <!-- Flexslider -->
  <%= javascript_include_tag "jquery.flexslider-min" %>
  <!-- Carousel -->
  <%= javascript_include_tag "owl.carousel.min" %>
  <!-- Magnific Popup -->
  <%= javascript_include_tag "jquery.magnific-popup.min" %>
  <%= javascript_include_tag "magnific-popup-options" %>
  <!-- Counters -->
  <%= javascript_include_tag "jquery.countTo" %>
  <!-- Main -->
  <%= javascript_include_tag "main" %>

  </body>
</html>
