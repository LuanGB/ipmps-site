<% if current_site_config.services.present? %>
<div id="marinas-services" class="marinas-light-grey">
    <div class="row animate-box">
        <div class="col-md-6 col-md-offset-3 text-center marinas-heading">
            <h2>Reuniões e Cultos</h2>
            <p>Confira os horários de nossas reuniões e venha nos visitar!</p>
        </div>
    </div>
    <div class="row">
        <% current_site_config.services.each do |service| %>
        <div class="col-md-4 animate-box">
            <div class="services">
                <a href="#" class="img-holder"><img class="img-responsive" src="<%= service.image_path %>" alt="<%= service.title %>"></a>
                <div class="desc">
                    <h3><%= service.title %></h3>
                    <p><%= service.description %></p>
                    <p><strong><i class="icon-clock"></i> <%= service.schedule %></strong></p>
                </div>
            </div>
        </div>
        <% end %>
    </div>
</div>
<% end %>

<% if (sermons = Sermon.recent.limit(3).presence) %>
<div id="marinas-sermon">
    <div class="row animate-box">
        <div class="col-md-6 col-md-offset-3 text-center marinas-heading">
            <h2>Sermões</h2>
            <p>Assista aos nossos sermões mais recentes e fortaleça sua fé com a Palavra de Deus.</p>
        </div>
    </div>
    <div class="row equal-height-container">
        <% sermons.each do |sermon| %>
        <div class="col-md-4 text-center animate-box">
            <div class="sermon-entry">
                <div class="sermon" style="background-image: url(<%= sermon.thumbnail_url || 'images/sermon-1.jpg' %>);">
                    <div class="play">
                        <% if sermon.youtube_embed_url.present? %>
                        <a class="popup-youtube" href="<%= sermon.youtube_url %>"><i class="icon-play3"></i></a>
                        <% end %>
                    </div>
                </div>
                <h3><%= sermon.title %></h3>
                <% if sermon.published_at.present? %>
                <span><%= l(sermon.published_at, format: :long) %></span>
                <% end %>
                <% if sermon.duration.present? %>
                <p><i class="icon-clock"></i> <%= sermon.duration %></p>
                <% end %>
            </div>
        </div>
        <% end %>
    </div>
</div>
<% end %>

<% if (verses = current_site_config.verses.presence) %>
<div id="marinas-bible-verse">
    <div class="overlay"></div>
    <div class="row">
        <div class="col-md-10 col-md-offset-1">
            <div class="row animate-box">
                <% if verses.count > 2 %><div class="owl-carousel owl-carousel-fullwidth"><% end %>
                  <% verses.each do |verse| %>
                    <div class="item">
                        <div class="bible-verse-slide active text-center">
                            <blockquote>
                                <p>&ldquo;<%= verse.content %>&rdquo;</p>
                                <span><%= verse.reference %></span>
                            </blockquote>
                        </div>
                    </div>
                  <% end %>
                <% if verses.count > 2 %></div><% end %>
            </div>
        </div>
    </div>
</div>
<% end %>
<% if @latest_events.present? %>
<div id="marinas-events">
    <div class="row animate-box">
        <div class="col-md-6 col-md-offset-3 text-center marinas-heading">
            <h2>Próximos Eventos</h2>
            <p>Dignissimos asperiores vitae velit veniam totam fuga molestias accusamus alias autem provident. Odit ab aliquam dolor eius.</p>
        </div>
    </div>
    <div class="row equal-height-container">
      <% @latest_events.each do |post| %>
        <div class="col-md-4 animate-box">
            <div class="events-entry">
                <span class="date"><%= I18n.l(post.publication_date, format: :short) %></span>
                <h3><a href="<%= post_path(post) %>"><%= post.title %></a></h3>
                <p><%= post.description.truncate(100).truncate_words(20, omission: '...') %></p>
                <a href="<%= post_path(post) %>">Leia Mais <i class="icon-arrow-right3"></i></a>
            </div>
        </div>
      <% end %>
    </div>
</div>
<% end %>
<% if @latest_news.present? %>
<div id="marinas-news" class="marinas-light-grey">
    <div class="row animate-box">
        <div class="col-md-6 col-md-offset-3 text-center marinas-heading">
            <h2>Últimas Notícias</h2>
            <p>Acompanhe as novidades da nossa igreja</p>
        </div>
    </div>
    <div class="row equal-height-container">
        <% @latest_news.each do |post| %>
          <div class="col-md-3 animate-box">
              <div class="news">
                  <a href="<%= post_path(post) %>" class="img-holder">
                      <img class="img-responsive" src="<%= post.thumbnail_path %>" alt="image of the post <%= post.title&.downcase %>">
                  </a>
                  <div class="desc">
                      <span class="date"><%= I18n.l(post.publication_date, format: :short) %></span>
                      <h3><a href="<%= post_path(post) %>"><%= post.title.truncate(30) %></a></h3>
                      <p><%= post.description.truncate(100, omission: '').truncate_words(20, omission: '...') %></p>
                      <a href="<%= post_path(post) %>">Leia Mais <i class="icon-arrow-right3"></i></a>
                  </div>
              </div>
          </div>
        <% end %>
    </div>
</div>
<% end %>