
<% if current_site_config.slides.present? %>
  <aside id="marinas-hero">
      <div class="flexslider">
          <ul class="slides">
            <% current_site_config.slides.each do |slide| %>
              <li style="background-image: url(<%= slide.image_path %>);">
                  <div class="overlay"></div>
                  <div class="container-fluid">
                      <div class="row">
                          <div class="col-md-6 col-md-offset-3 text-center">
                              <div class="slider-text">
                                  <div class="slider-text-inner">
                                      <h1><%= slide[:title] %></h1>
                                      <h2><%= slide[:subtitle].html_safe %></h2>
                                      <p>
                                        <%= slide[:content].html_safe %>
                                      </p>
                                  </div>
                              </div>
                          </div>
                      </div>
                  </div>
              </li>
            <% end %>
          </ul>
      </div>
  </aside>
<% end %>
<div id="marinas-intro">
    <div class="row animate-box">
        <div class="col-md-12 col-md-offset-0 text-center">
            <h2><%= current_site_config.site_data["intro_title"] %></h2>
            <span><%= current_site_config.site_data["intro_subtitle"] %></span>
        </div>
    </div>
</div>
<hr>

